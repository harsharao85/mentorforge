# Copy this file to .env.local and fill in values.
# .env.local is gitignored — never commit credentials.

# Neo4j
NEO4J_PASSWORD=change_me_strong_password

# MCP server bearer token — AgentCore Gateway uses this to authenticate.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=change_me_bearer_token

# Ollama base URL — override for Apple Silicon (native Ollama, Mac demo host).
# Linux (container): leave unset — defaults to http://ollama:11434 (Docker DNS).
# Mac (mcp_server in Docker → native Ollama): set to http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434
